generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  SIGNAL
}

enum BookingMode {
  INSTANT
  APPROVAL_REQUIRED
}

enum CallType {
  AUDIO
  VIDEO
}

enum OtpType {
  PHONE
  EMAIL
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id             String  @id @default(cuid())
  email          String? @unique
  phoneNumber    String? @unique
  passwordHash   String?
  fullName       String
  role           Role
  whatsappNumber String?
  gender         String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?

  sentMessages    Message[] @relation("senderMessages")
  reviewsAuthored Review[]  @relation("reviewAuthor")
  reviewsReceived Review[]  @relation("reviewTarget")

  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@index([role])
}

//////////////////////////////////////////////////////
// OTP
//////////////////////////////////////////////////////

model OtpVerification {
  id        String    @id @default(cuid())
  target    String // phone or email
  code      String
  type      OtpType
  status    OtpStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([target, type, status])
  @@index([target, type, createdAt])
}

//////////////////////////////////////////////////////
// DOCTOR
//////////////////////////////////////////////////////

model DoctorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio               String?
  specialization    String?
  subSpecialties    String[] @default([])
  conditions        String[] @default([])
  degree            String?
  university        String?
  graduationYear    Int?
  priceCents        Int      @default(0)
  currency          String   @default("INR")
  yearsOfExperience Int?

  clinicName    String?
  clinicAddress String?
  city          String?
  country       String?

  latitude  Float?
  longitude Float?

  licenseNumber String? @unique

  // Core Product Features
  bookingMode      BookingMode @default(INSTANT)
  isOnline         Boolean     @default(false)
  responseTimeMins Int?
  nextAvailableAt  DateTime?

  consultationModes  String[] @default([])
  onlineConsultation Boolean  @default(false)

  onboardingStatus DoctorApprovalStatus @default(DRAFT)

  adminNotes  String?
  submittedAt DateTime?
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents      DoctorDocument[]
  availabilities Availability[]
  appointments   Appointment[]

  @@index([onboardingStatus, city])
  @@index([isOnline, nextAvailableAt])
}

//////////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////////

model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?
  gender      String?
  address     String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// DOCTOR DOCUMENTS
//////////////////////////////////////////////////////

model DoctorDocument {
  id       String        @id @default(cuid())
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  title   String
  fileUrl String

  createdAt DateTime @default(now())

  @@index([doctorId])
}

//////////////////////////////////////////////////////
// AVAILABILITY
//////////////////////////////////////////////////////

model Availability {
  id       String        @id @default(cuid())
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String

  slotMins Int     @default(30)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, dayOfWeek, isActive])
}

//////////////////////////////////////////////////////
// APPOINTMENT (GUEST + USER SUPPORT)
//////////////////////////////////////////////////////

model Appointment {
  id String @id @default(cuid())

  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])

  // Optional user linkage
  patientId String?
  patient   PatientProfile? @relation(fields: [patientId], references: [id])

  // Guest booking data
  patientName  String
  patientPhone String
  patientEmail String?

  startAt DateTime
  endAt   DateTime

  status    AppointmentStatus @default(REQUESTED)
  isInstant Boolean           @default(false)

  reason String?

  // Payment fields
  paymentId     String?
  payment       Payment?
  paymentStatus PaymentStatus @default(PENDING)

  conversation Conversation?
  callSessions CallSession[]
  review       Review?

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, startAt])
  @@index([patientPhone, startAt])
  @@index([patientEmail])
  @@index([doctorId, startAt, status])
  @@index([paymentStatus, status])
  @@index([status, startAt, reminderSentAt])
}

//////////////////////////////////////////////////////
// CHAT
//////////////////////////////////////////////////////

model Conversation {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  type   MessageType @default(TEXT)
  body   String
  isRead Boolean     @default(false)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("senderMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

//////////////////////////////////////////////////////
// CALLS
//////////////////////////////////////////////////////

model CallSession {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  type CallType

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([appointmentId, startedAt])
}

//////////////////////////////////////////////////////
// REVIEWS
//////////////////////////////////////////////////////

model Review {
  id            String @id @default(cuid())
  appointmentId String @unique

  authorId     String
  doctorUserId String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author      User        @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  doctorUser  User        @relation("reviewTarget", fields: [doctorUserId], references: [id], onDelete: Restrict)

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorUserId, createdAt])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id                String   @id @default(cuid())
  appointmentId     String   @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  stripeSessionId   String   @unique
  amount            Int      // in cents
  currency          String   @default("INR")
  
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  
  idempotencyKey    String   @unique
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([appointmentId, status])
  @@index([stripeSessionId])
  @@index([status, createdAt])
}

//////////////////////////////////////////////////////
// STATIC PAGES
//////////////////////////////////////////////////////

model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique  // e.g. "about", "privacy", "faq"
  title     String
  content   String

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// BLOG
//////////////////////////////////////////////////////

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String
  author      String
  readMins    Int        @default(5)
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_REMINDER
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  CHAT_MESSAGE
  CALL_STARTED
  DOCTOR_APPROVAL
}

model Notification {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String
  linkUrl String
  meta    Json?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////
// EMAIL LOG
//////////////////////////////////////////////////////

model EmailLog {
  id                String   @id @default(cuid())
  
  to                String
  template          String
  subject           String
  
  status            EmailStatus @default(PENDING)
  attemptCount      Int     @default(0)
  lastAttemptAt     DateTime?
  failureReason     String?
  
  appointmentId     String?
  userId            String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([status, lastAttemptAt])
  @@index([appointmentId])
}
